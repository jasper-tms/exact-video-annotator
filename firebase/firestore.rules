rules_version = '2';

// Security rules for the exact-video-annotator / Video Examiner backend.
//
// The only data stored is one document per user at users/{uid}, holding that
// user's synced preferences (a `preferences` map of {value, updatedAt}
// envelopes) — no video, no annotations, ever. A user may read and write only
// their own document, and only while signed in. Nothing else in the database
// is accessible.
//
// This file is the source of truth for the rules, not the Firebase console.
// Deploy it from the repo root with:
//   ./deploy-firebase-rules.sh
// (see that script and firebase/_deploy_common.sh).

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
